# ============================================================================
# Reborn (no Judge0 version) — for Render/Railway/Fly deployment
# ============================================================================

# ---- Authentication ----
# JWT secret used by the API and NextAuth. Generate a strong random string:
# openssl rand -base64 32
AUTH_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

NEXTAUTH_SECRET=change-me-to-another-long-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000
# On Render, set these to your actual domain: https://your-domain.onrender.com

# ---- Database (Postgres) ----
POSTGRES_USER=reborn
POSTGRES_PASSWORD=reborn
POSTGRES_DB=reborn
DATABASE_URL=postgresql://reborn:reborn@localhost:5432/reborn?schema=public
# On Render/Railway, this is auto-generated; copy from the Postgres service output

# ---- Node API ----
API_PORT=4000
# GRADER_URL: intentionally NOT set. If unset, submissions are marked PENDING for manual review.
# If you want auto-grading, set this to a Judge0 API (self-hosted or public RapidAPI).

# ---- Web (Next.js / NextAuth) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# On Render, set to https://your-api-domain.onrender.com
API_INTERNAL_URL=http://localhost:4000
# On Render/same network, use http://reborn-api:4000 (internal); override in render.yaml if needed
