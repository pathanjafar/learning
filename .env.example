# ---- Shared secret used to sign/verify auth JWTs (API issues, web verifies) ----
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# ---- Application Postgres (users, progress, content) ----
POSTGRES_USER=reborn
POSTGRES_PASSWORD=reborn
POSTGRES_DB=reborn
# Used by Prisma (packages/db) and the Node API:
DATABASE_URL=postgresql://reborn:reborn@localhost:5432/reborn?schema=public

# ---- Node API ----
API_PORT=4000
GRADER_URL=http://localhost:8001

# ---- Grader (Python) ----
GRADER_PORT=8001
JUDGE0_URL=http://localhost:2358

# ---- Web (Next.js / NextAuth) ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-too
# Where the browser-side and server-side web app reach the Node API:
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# ---- Execution limits (seconds / KB) applied to every submission ----
EXEC_CPU_TIME_LIMIT=5
EXEC_WALL_TIME_LIMIT=10
EXEC_MEMORY_LIMIT_KB=128000
EXEC_MAX_PROCESSES=60
EXEC_MAX_OUTPUT_KB=256
