{
  "name": "reborn",
  "private": true,
  "version": "0.1.0",
  "description": "Learn-to-code + DSA platform with in-browser execution and auto-grading.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm --workspace packages/db run generate",
    "db:migrate": "npm --workspace packages/db run migrate",
    "db:seed": "npm --workspace packages/db run seed",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "compose:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "compose:down": "docker compose -f infra/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  }
}
